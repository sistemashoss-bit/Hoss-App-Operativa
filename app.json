{
  "expo": {
    "name": "Hoss Installers",
    "slug": "app-de-hoss",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/images/hoss-icon.png",

    "scheme": "appdehoss",
    "userInterfaceStyle": "automatic",

    "ios": {
      "icon": "./assets/images/hoss-icon.png",
      "bundleIdentifier": "com.hossapp.appdehoss"
    },

    "android": {
      "package": "com.hossapp.appdehoss",

      "adaptiveIcon": {
        "foregroundImage": "./assets/images/hoss-icon-foreground.png",
        "backgroundColor": "#0D0D0D",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },

      "predictiveBackGestureEnabled": false
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/app-logo.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D0D0D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "03e7c6b6-5f4a-473d-9b02-d58a912ed08b"
      }
    },

    "owner": "hoss-app"
  }
}